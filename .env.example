# Config de Firebase (Hosting + Auth). Copiar a `.env.local` y completar.
# `.env.local` está en .gitignore: la config web de Firebase es pública por diseño,
# pero no hace falta fijarla en el repo.
# La app arranca sin login si estas variables faltan.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Opcionales (no hacen falta sólo para Auth):
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
